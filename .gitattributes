# Satir sonlari platformlar arasinda bozulmasin: Windows'ta klonlanan bir
# depodaki Baslat-Mac.command CRLF'e cevrilirse Mac'te calismaz
# (bash: 'cd: $'...\r'' hatasi verir).
*.command text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.py      text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.onnx    binary
*.jpg     binary
*.wav     binary
