# DALSAN İSG — Ayarlar
# Bu dosya .env olarak kopyalanır. Kontrol Paneli ilk açılışta otomatik yapar.

# --- Erişim ve sunucu ---
# İki ayar dosyanın SONUNDADIR: YONETICI_SIFRESI ve SUNUCU_ADRESI.
# Sistemi ağa açmadan önce ikisini birlikte okuyun; ağa açık + şifresiz bir
# kurulumu sistem zaten reddeder (docs/15-UZAKTAN-ERISIM.md).
#
# Sistemin PORTUNU Kontrol Paneli belirler: http://<adres>:8080
# (Burada değiştirilecek bir port ayarı bilerek yok — okunmayan bir ayar
#  ekranda yanlış bilgi gösterirdi.)

# --- Veri ---
VERITABANI_YOLU=veri/dalsan.db
GORUNTU_KLASORU=veri/goruntuler
# Nesne kütüphanesi fotoğrafları. GÖRÜNTÜ KLASÖRÜNÜN DIŞINDA durur: görüntü
# klasörünü saklama süresi dolunca bakım temizler, nesne fotoğrafları ise
# kullanıcının elle tanıttığı tanımlardır ve kendiliğinden silinmez.
NESNE_KLASORU=veri/nesneler

# --- Saklama süreleri (gün) — KVKK politikasıyla uyumlu olmalı ---
OLAY_SAKLAMA_GUN=180
GORUNTU_SAKLAMA_GUN=90
KKD_HAM_VERI_SAKLAMA_GUN=30
SISTEM_OLAY_SAKLAMA_GUN=90

# --- Bakım ---
# Boş disk bu değerin (GB) altına inince olay listesine uyarı düşer
DISK_UYARI_GB=5
# KKD veri toplama: kamera başına saatte en çok kaç örnek
KKD_ORNEK_SAAT_LIMIT=60

# --- Analiz ---
CIKARIM_CIHAZI=cpu          # cpu | cuda   (fabrikada: cuda)

# Tespit modelinin kullanacagi cekirdek sayisi. 0 = otomatik (tum cekirdekler).
# Sunucu baska isler de yapiyorsa sinirlayin: ornegin 4 cekirdekli bir makinede
# CIKARIM_IS_PARCACIGI=3 birakmak, arayuzun ve kamera okumanin nefes almasini
# saglar. Tek basina calisan bir sunucuda 0 en hizlisidir.
CIKARIM_IS_PARCACIGI=0
# Yeni eklenen kameranın varsayılan örnekleme hızı (her kamerada ayrı ayarlanır)
KARE_ORNEKLEME_FPS=6
# Kamera sağlığı ekranı: ölçülen hız, ayarlanan hızın bu oranının altına inerse
# kamera "yavaş" diye işaretlenir (0,6 = %60). Yükseltirseniz daha çabuk uyarır.
FPS_UYARI_ORANI=0.6

# --- Takip ve kamera bağlantısı ---
# Görüntüden kaybolan bir kişi/araç kaç saniye AYNI kimlikle beklensin. Kısa
# olursa bir kolonun arkasından geçen kişi "yeni biri" sayılır, kalış süresi
# sıfırlanır ve uyarı tekrarlar; uzun olursa yan yana yürüyen iki kişinin
# kimlikleri karışabilir. Kayıtlı bir videoda kimlik değişimleri sayılarak ayarlanır.
TAKIP_HAFIZA_SN=2
# Akan görüntü bu kadar saniye kesilirse kamera "çevrimdışı" sayılır ve Olaylar'a
# yazılır. (Yeni eklenen kameraya ilk bağlantı için ayrıca 60 sn tanınır.)
KAMERA_KOPUK_ESIGI_SN=10
# "Kamera tekrar çevrimiçi" olayı, görüntü bu kadar saniye KESİNTİSİZ aktıktan
# sonra yazılır: gidip gelen bir bağlantı olay listesini doldurmasın.
KAMERA_UP_KARARLILIK_SN=5
# RTSP kamerasına bağlanma ve görüntü bekleme sınırları (milisaniye). Yanıt
# vermeyen bir kamera bu süreden sonra bırakılır ve yeniden denenir.
RTSP_ACILIS_ZAMAN_ASIMI_MS=5000
RTSP_OKUMA_ZAMAN_ASIMI_MS=10000

# --- Analiz sağlığı ---
# Analiz bu kadar saniye ilerlemezse (görüntü gelirken) "Analiz takıldı" olayı
# yazılır ve komuta ekranlarında kırmızı şerit çıkar. En az 20 sn.
BEKCI_ESIGI_SN=90
# Takılmada ne yapılsın: uyar = yalnız uyar; yeniden_baslat = program kendini
# kapatır ki Docker ya da systemd yeniden açsın. Masaüstü programında her zaman
# yalnız uyarır (Kontrol Paneli de kapanmasın diye).
BEKCI_TEPKISI=uyar
# Bir kameranın işlenen görüntü hızı, hedefin (FPS_UYARI_ORANI oranında) altında
# bu kadar saniye kalırsa "Analiz yavaşladı" olayı yazılır.
ANALIZ_YAVAS_SURE_SN=60
# Bir kamerada bu kadar görüntü üst üste işlenemezse o kameranın işleme hattı
# yeniden kurulur ve "Analiz yavaşladı" olayı yazılır.
ANALIZ_HATA_ESIGI=30

# --- Tespit hassasiyeti ---
# Düşük eşik = daha çok tespit ama daha çok YANLIŞ ALARM. Yanlış alarm, kaçırılan
# ihlalden daha kötüdür (docs/00) — bu yüzden varsayılanlar temkinlidir.
# Sahada ayarlarken: önce kamera sayfasındaki canlı görüntüde kutulara bakın.
TESPIT_GUVEN_ESIGI=0.35
# İnsan için ayrı ve daha düşük eşik: kaçırılan insan, kaçırılan araçtan risklidir
TESPIT_INSAN_GUVEN_ESIGI=0.28
# Üst üste binen kutuların birleştirilmesi (0.1-0.9). Kalabalıkta 0.5-0.6 denenebilir
TESPIT_NMS_ESIGI=0.45
# Bu kenar uzunluğundan (piksel) küçük kutular atılır — uzaktaki gürültü elenir
TESPIT_EN_KUCUK_KENAR_PX=12

# --- Görüntü kalitesi ---
# Kamera görüntüsü karanlık/sisli/düşük kontrastlıysa yerel kontrast dengeleme
# uygular (renkleri bozmaz). kapali | otomatik — ayrıntı: docs/12
GORUNTU_IYILESTIRME=kapali
# Tespit modeli. Dosya yoksa sistem ilk açılışta BİR KEZ kendisi indirir
# (internet gerekir); elle indirmek için: bash models/indir.sh
# Geliştirme: NextGen AI Hızlı (yolox_tiny.onnx)
# Fabrika:    NextGen AI İsabetli (yolox_s.onnx — daha isabetli, daha yavaş)
# DOSYA ADINI DEĞİŞTİRMEYİN: sistem modeli bu adla bulur ve indirir.
MODEL_DOSYASI=models/yolox_tiny.onnx
# KKD (baret/yelek) modeli. Sahadan toplanan veriyle ÜRÜN DIŞINDA eğitilir
# (docs/04 §6). Dosya yoksa KKD kuralı olay üretmez; KKD sayfası bunu söyler.
# Dosya konunca özeti models/SHA256SUMS'a eklenir, yoksa model YÜKLENMEZ.
# Yeni model dosyası yeniden başlatmada yüklenir.
KKD_MODEL_DOSYASI=models/kkd.onnx
# KKD anons kapısı (docs/17 §5.7). KKD kuralı gölge modda doğar: olay yazılır,
# hoparlör susar. Anons, kalem (baret, yelek) ve model sürümü başına şu dört
# şart sağlanmadan açılmaz: incelenen olaylarda precision en az
# KKD_KAPI_PRECISION; ilk olaydan bu yana en az KKD_KAPI_GUN gün; en az
# KKD_KAPI_EN_AZ_OLAY incelenmiş olay; incelenmemiş olay kalmamış.
# Neden 30: hiç yanlış alarm yokken bile n olayla söylenebilecek en iyi şey
# "hata oranı %95 güvenle en çok 3/n"dir ("üçler kuralı"); 30 olayda bu %10'dur.
KKD_KAPI_PRECISION=0.90
KKD_KAPI_GUN=3
KKD_KAPI_EN_AZ_OLAY=30

# --- Nesne kütüphanesi (Nesneler sayfası) ---
# Kendi nesnenizi fotoğrafla tanıtma. DİKKAT: burada tanıtılan nesne CANLI
# KAMERALARDA ARANMAZ; yalnızca o sayfaya yüklediğiniz fotoğraflarda aranır.
# Kabul edilen fotoğraf türleri (virgülle ayrılır)
NESNE_IZINLI_UZANTILAR=jpg,jpeg,png,webp,bmp
# Tek fotoğrafın en büyük boyutu (MB) — telefon fotoğrafı rahat sığar
NESNE_FOTO_EN_BUYUK_MB=12
# Tek taramada işlenecek en çok fotoğraf. Yükseltirseniz tarama uzar.
NESNE_TARAMA_EN_COK_DOSYA=6
# Kabul çıtası (0-1). Altında kalan en iyi benzerlik bile "eşleşme yok" sayılır.
# Yükseltirseniz daha az ama daha emin eşleşme; düşürürseniz daha çok yanlış eşleşme.
# 0,24 ölçülerek seçildi (tests/nesne_kiyas, 264 sorgu): bu çıtada yanlış isim
# sıfırdır, ilk yanlış isim bir adım aşağıda (0,22) çıkar.
# Bu sayı GÜVENLİKTEN sorumlu değildir: "yalnız renge dayanan kanıt tek başına
# isim yazdıramaz" güvencesi çıtaya ORANLIDIR, yani çıtayı kaça çekerseniz çekin
# geçerlidir (backend/app/nesneler/kutuphane.py → TEK_KANIT_TAVAN_ORANI).
# Değiştirdiğinizde isabet/kaçırma dengesini oynatırsınız, güvenceyi delmezsiniz.
# AMA ÇITAYI DÜŞÜRMEK YİNE DE YANLIŞ İSİM ÜRETİR — ölçüldü: 0,05'e çekilince
# 8 "aynı renkte düz yabancı" sorgunun 7'sine isim yazıldı. O isimleri yazdıran
# renk değil, ZAYIF DESEN kanıtıdır (birkaç gürültü noktası hizalanır). Yani
# güvence tutuyor, çıta yine de gereklidir. 0,24'ün altına inmeyin.
#
# KURULU BİR SUNUCUYU GÜNCELLİYORSANIZ: bu dosya git'e girmez, yani sizin
# .env'iniz eski değerde (0,42) kalmış olabilir. Yeni motorda 0,42 hiçbir nesne
# BULDURMAZ (ölçüldü: 204 sorgunun 0'ı) ve yanlış isimden de korumaz — iki
# ayarda da yanlış isim sıfırdır. Değeri kimse haberiniz olmadan değiştirmez;
# onun yerine Nesneler sayfasında Türkçe bir not çıkar ve ayarı ekrandan
# değiştirebilirsiniz: Ayarlar → "Nesne arama titizliği".
NESNE_ESLESME_ESIGI=0.24

# --- Giriş şifresi ---
# BOŞ bırakılırsa giriş sorulmaz. Sistem yalnızca bu bilgisayardan (127.0.0.1)
# açılıyorsa boş kalabilir.
#
# FABRİKA SUNUCUSUNA ÇIKARKEN VEYA SİSTEMİ AĞA AÇARKEN DOLDURUN: kural
# değiştirebilen, kamera silebilen ve hoparlörden anons yaptırabilen bir sistem
# şirket ağında bile şifresiz durmamalı. En az 6 karakter.
YONETICI_SIFRESI=

# --- Sunucunun dinleyeceği adres ---
# 127.0.0.1 = yalnız bu bilgisayar (varsayılan, en güvenli)
# 0.0.0.0   = ağdaki diğer cihazlar da erişebilir (telefon, başka bilgisayar)
#
# 0.0.0.0 yapabilmek için YONETICI_SIFRESI DOLU olmalıdır; boşsa sistem
# açılmayı reddeder. Fabrika dışından erişim (evden, telefondan) için önce
# docs/15-UZAKTAN-ERISIM.md belgesini okuyun — doğrudan internete açmak
# ÖNERİLMEZ.
SUNUCU_ADRESI=127.0.0.1

# --- İzinli sunucu adları ---
# Sisteme başka bir cihazdan HANGİ ADRESLE giriliyorsa o ad buraya yazılır
# (virgülle ayırın): sunucunun IP'si, şirket içi adı, Tailscale ya da tünel adı.
# 127.0.0.1, localhost ve SUNUCU_ADRESI her zaman izinlidir.
# Yazılmamış bir adla gelen istek "Bu adrese izin verilmiyor" sayfasına düşer:
# başka bir internet sitesinin kendi adını bu bilgisayara yönlendirip sisteme
# ulaşmasını (DNS yeniden bağlama) bu liste durdurur. Joker (*) kabul edilmez.
# Örnek: IZINLI_SUNUCU_ADLARI=192.168.1.50, isg.dalsan.local
IZINLI_SUNUCU_ADLARI=

# --- Anons: null | ses_karti | http ---
ANONS=null
# ANONS=ses_karti iken hangi ses ÇIKIŞINA çalınacağı. Boş = işletim sisteminin
# varsayılan çıkışı. Bluetooth hoparlör de bir çıkıştır: önce işletim
# sisteminden eşleştirin, sonra Anons sistemi sayfasındaki listeden seçin.
# NOT: bu ayar yalnızca Linux'ta uygulanır. Mac ve Windows'un hazır ses
# çalıcılarında cihaz seçeneği yoktur; oralarda çıkış, işletim sisteminin ses
# ayarlarından seçilir (Anons sayfası bunu ekranda da söyler).
# Elle yazmayın: Anons sistemi sayfasındaki listeden seçin.
ANONS_SES_CIHAZI=
ANONS_HTTP_ADRESI=
# IP hoparlörün HTTP arayüzü tek tip değildir; cihazınıza uyanı seçin:
#   json → gövdede {"key":..., "text":...} JSON gönderilir (varsayılan)
#   form → gövdede key=...&text=... form alanı gönderilir
#   get  → yalnızca adres çağrılır; hangi mesajın çalınacağını ADRES taşır,
#          bu yüzden adreste {anahtar} yer tutucusu bulunmalıdır. Örnek:
#          ANONS_HTTP_ADRESI=http://10.0.0.9/play?file={anahtar}
# Hangi cihaz için hangisi: docs/14-ANONS-SISTEMI-BAGLAMA.md
ANONS_HTTP_BICIMI=json
# Aynı kamera+mesaj için hoparlörün en az kaç saniye susacağı
ANONS_BEKLEME_SN=30

# --- Yüklenen test videoları (Kameralar → Video Yükle) ---
# Gerçek kamera bağlamadan, elinizdeki bir video dosyasıyla deneme yapmak
# için: video yüklenir, üzerine bölgeler çizilir, kurallar aynen çalışır.
# Yüklenen dosyaların durduğu klasör (yedeklerken veri/ ile birlikte gider)
VIDEO_KLASORU=veri/videolar
# Kabul edilen video türleri (virgülle ayrılır)
VIDEO_IZINLI_UZANTILAR=mp4,mov,avi,mkv,m4v
# Tek videonun en büyük boyutu (MB). Yükleme bu sınırı aşarsa yarıda kesilir
# ve yarım dosya diskte BIRAKILMAZ.
VIDEO_EN_BUYUK_MB=1024
