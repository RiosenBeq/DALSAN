# DALSAN İSG — Ayarlar
# Bu dosya .env olarak kopyalanır. Kontrol Paneli ilk açılışta otomatik yapar.

# --- Erişim ---
# Giriş şifresi şimdilik YOK: sistem tek makinede, yalnızca bu bilgisayardan
# (127.0.0.1) açılır. Fabrika sunucusuna çıkmadan önce geri eklenir (docs/07 #0).

# --- Sunucu ---
# Sistemin adresi Kontrol Paneli tarafından belirlenir: http://127.0.0.1:8080
# (Burada değiştirilecek bir port ayarı bilerek yok.)

# --- Veri ---
VERITABANI_YOLU=veri/dalsan.db
GORUNTU_KLASORU=veri/goruntuler
# Nesne kütüphanesi fotoğrafları. GÖRÜNTÜ KLASÖRÜNÜN DIŞINDA durur: görüntü
# klasörünü saklama süresi dolunca bakım temizler, nesne fotoğrafları ise
# kullanıcının elle tanıttığı tanımlardır ve kendiliğinden silinmez.
NESNE_KLASORU=veri/nesneler

# --- Saklama süreleri (gün) — KVKK politikasıyla uyumlu olmalı ---
OLAY_SAKLAMA_GUN=180
GORUNTU_SAKLAMA_GUN=90
KKD_HAM_VERI_SAKLAMA_GUN=30
SISTEM_OLAY_SAKLAMA_GUN=90

# --- Bakım ---
# Boş disk bu değerin (GB) altına inince olay listesine uyarı düşer
DISK_UYARI_GB=5
# KKD veri toplama: kamera başına saatte en çok kaç örnek
KKD_ORNEK_SAAT_LIMIT=60

# --- Analiz ---
CIKARIM_CIHAZI=cpu          # cpu | cuda   (fabrikada: cuda)
# Yeni eklenen kameranın varsayılan örnekleme hızı (her kamerada ayrı ayarlanır)
KARE_ORNEKLEME_FPS=6
# Kamera sağlığı ekranı: ölçülen hız, ayarlanan hızın bu oranının altına inerse
# kamera "yavaş" diye işaretlenir (0,6 = %60). Yükseltirseniz daha çabuk uyarır.
FPS_UYARI_ORANI=0.6

# --- Tespit hassasiyeti ---
# Düşük eşik = daha çok tespit ama daha çok YANLIŞ ALARM. Yanlış alarm, kaçırılan
# ihlalden daha kötüdür (docs/00) — bu yüzden varsayılanlar temkinlidir.
# Sahada ayarlarken: önce kamera sayfasındaki canlı görüntüde kutulara bakın.
TESPIT_GUVEN_ESIGI=0.35
# İnsan için ayrı ve daha düşük eşik: kaçırılan insan, kaçırılan araçtan risklidir
TESPIT_INSAN_GUVEN_ESIGI=0.28
# Üst üste binen kutuların birleştirilmesi (0.1-0.9). Kalabalıkta 0.5-0.6 denenebilir
TESPIT_NMS_ESIGI=0.45
# Bu kenar uzunluğundan (piksel) küçük kutular atılır — uzaktaki gürültü elenir
TESPIT_EN_KUCUK_KENAR_PX=12

# --- Görüntü kalitesi ---
# Kamera görüntüsü karanlık/sisli/düşük kontrastlıysa yerel kontrast dengeleme
# uygular (renkleri bozmaz). kapali | otomatik — ayrıntı: docs/12
GORUNTU_IYILESTIRME=kapali
# Tespit modeli. Dosya yoksa sistem ilk açılışta BİR KEZ kendisi indirir
# (internet gerekir); elle indirmek için: bash models/indir.sh
# Geliştirme: NextGen AI Hızlı (yolox_tiny.onnx)
# Fabrika:    NextGen AI İsabetli (yolox_s.onnx — daha isabetli, daha yavaş)
# DOSYA ADINI DEĞİŞTİRMEYİN: sistem modeli bu adla bulur ve indirir.
MODEL_DOSYASI=models/yolox_tiny.onnx

# --- Nesne kütüphanesi (Nesneler sayfası) ---
# Kendi nesnenizi fotoğrafla tanıtma. DİKKAT: burada tanıtılan nesne CANLI
# KAMERALARDA ARANMAZ; yalnızca o sayfaya yüklediğiniz fotoğraflarda aranır.
# Kabul edilen fotoğraf türleri (virgülle ayrılır)
NESNE_IZINLI_UZANTILAR=jpg,jpeg,png,webp,bmp
# Tek fotoğrafın en büyük boyutu (MB) — telefon fotoğrafı rahat sığar
NESNE_FOTO_EN_BUYUK_MB=12
# Tek taramada işlenecek en çok fotoğraf. Yükseltirseniz tarama uzar.
NESNE_TARAMA_EN_COK_DOSYA=6
# Kabul çıtası (0-1). Altında kalan en iyi benzerlik bile "eşleşme yok" sayılır.
# Yükseltirseniz daha az ama daha emin eşleşme; düşürürseniz daha çok yanlış eşleşme.
NESNE_ESLESME_ESIGI=0.42

# --- Anons: null | ses_karti | http ---
ANONS=null
ANONS_HTTP_ADRESI=
# Aynı kamera+mesaj için hoparlörün en az kaç saniye susacağı
ANONS_BEKLEME_SN=30
